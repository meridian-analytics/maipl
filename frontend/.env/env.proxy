# Same-origin API requests are routed to Django by the development gateway.
MAIPL_ANNOTATION_BACKEND=
MAIPL_AUTH_BACKEND=
MAIPL_FILE_BACKEND=
MAIPL_METRICS_BACKEND=
MAIPL_MODEL_RUNNER_BACKEND=
MAIPL_MODEL_TRAINER_BACKEND=
MAIPL_DATABASE_TOOL_BACKEND=

MAIPL_ANNOTATION_FRONTEND=/annotation-tool
MAIPL_AUTH_FRONTEND=/authentication-service
MAIPL_FILE_FRONTEND=/file-service
MAIPL_METRICS_FRONTEND=/metrics
MAIPL_MODEL_RUNNER_FRONTEND=/model-runner
MAIPL_MODEL_TRAINER_FRONTEND=/model-trainer
MAIPL_DATABASE_TOOL_FRONTEND=/database-tool
MAIPL_DOCUMENTATION_URL=https://docs.maipl.meridian.cs.dal.ca
MAIPL_REACT_QUERY_DEVTOOLS=true
VITE_HOST=0.0.0.0
VITE_HMR_CLIENT_PORT=8080
