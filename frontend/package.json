{
  "name": "@maipl/monorepo",
  "private": true,
  "scripts": {
    "@check": "biome check --apply .",
    "@build": "pnpm --parallel -F \"./apps/*\" build",
    "@preview": "docker compose up --build",
    "@start": "pnpm --parallel -F \"./apps/*\" start",
    "@tsc": "pnpm --parallel -F \"./apps/*\" exec tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "1.6.3"
  },
  "packageManager": "pnpm@9.0.1"
}
