{
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": false,
    "esModuleInterop": false,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": false,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": ["vite/client"]
  },
  "include": ["src"]
}
