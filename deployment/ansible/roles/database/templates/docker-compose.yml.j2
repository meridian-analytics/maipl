version: '3.8'

services:
  postgres:
    image: postgres:{{ postgresql_version }}
    container_name: postgres
    restart: always
    user: "999:999"
    environment:
      POSTGRES_PASSWORD: "{{ postgres_password }}"
      POSTGRES_USER: "{{ postgres_user | default('postgres') }}"
    volumes:
      - ./data:/var/lib/postgresql/data
    ports:
      - "{{ postgresql_port }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ postgres_user | default('postgres') }}"]
      interval: 10s
      timeout: 5s
      retries: 5

  pgadmin:
    image: dpage/pgadmin4:latest
    container_name: pgadmin
    restart: always
    user: "5050:5050"
    environment:
      PGADMIN_DEFAULT_EMAIL: "{{ pgadmin_email | default('admin@example.com') }}"
      PGADMIN_DEFAULT_PASSWORD: "{{ pgadmin_password | default('changeme') }}"
      PGADMIN_LISTEN_PORT: 80
    ports:
      - "{{ pgadmin_port | default('5050') }}:80"
    volumes:
      - ./pgadmin:/var/lib/pgadmin
    depends_on:
      - postgres 