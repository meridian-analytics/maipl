server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /tmp/positions.yaml

clients:
  - url: "{{ loki_url }}/loki/api/v1/push"

scrape_configs:
  - job_name: minio_logs
    static_configs:
      - targets:
          - localhost
        labels:
          job: minio
          environment: "{{ environment }}"
          host: "{{ inventory_hostname }}"
    pipeline_stages:
      - json:
          expressions:
            timestamp: time
            level: level
            message: msg
      - timestamp:
          source: timestamp
          format: RFC3339