# MAIPL Application Environment Configuration
# This file serves as a template for setting up your environment variables.
# Copy this file to .env and update the values according to your environment.

# IMPORTANT NOTE FOR MINIO SETUP:
# When initializing MinIO buckets, ensure that:
# 1. The MINIO_ACCESS_KEY and MINIO_SECRET_KEY have sufficient permissions to create buckets
# 2. The MINIO_BUCKET_NAME matches the bucket name in your Django settings
# 3. If using django_minio_backend, ensure MINIO_PRIVATE_BUCKETS and MINIO_PUBLIC_BUCKETS are properly configured
# 4. The MinIO server is accessible at the specified MINIO_ENDPOINT

# ===== Django Configuration =====
# Basic Django settings for the application
DJANGO_PORT=8000                                      # Port on which Django will run
DEBUG=1                                               # Set to 1 for development, 0 for production
DJANGO_ALLOWED_HOSTS=localhost,your-backend-domain.com  # Comma-separated list of allowed hosts
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://your-backend-domain.com,https://your-frontend-domain.com  # CSRF trusted origins
DJANGO_SECRET_KEY=your-secret-key-here                # Generate a secure random key for production

# ===== CORS Configuration =====
# Cross-Origin Resource Sharing settings
# Controls which domains can make requests to your API
CORS_ALLOW_ALL_ORIGINS=false                          # Set to true to allow all origins (not recommended for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com  # List of allowed origins

# ===== Email Configuration =====
# Settings for sending emails from the application
EMAIL_HOST=your-mail-server.com                       # SMTP server hostname
EMAIL_PORT=465                                        # SMTP server port (465 for SSL, 587 for TLS)
EMAIL_HOST_USER=your-email@example.com                # SMTP username
EMAIL_HOST_PASSWORD=your-email-password               # SMTP password
EMAIL_USE_TLS=False                                   # Use TLS encryption
EMAIL_USE_SSL=True                                    # Use SSL encryption
DEFAULT_FROM_EMAIL=your-email@example.com             # Default sender email address

# ===== MinIO Server Configuration =====
# Settings for the MinIO object storage server
MINIO_PORT=9000                                       # MinIO API port
MINIO_CONSOLE_PORT=9001                               # MinIO Console port
MINIO_ROOT_USER=minio-admin-username                  # MinIO root username (for admin console)
MINIO_ROOT_PASSWORD=minio-admin-password              # MinIO root password (for admin console)
MINIO_SERVER_URL=https://your-minio-api-domain.com    # Public URL for MinIO API
MINIO_BROWSER_REDIRECT_URL=https://your-minio-console-domain.com  # Public URL for MinIO Console

# ===== MinIO Django Backend Configuration =====
# Settings for Django to connect to MinIO
MINIO_ENDPOINT=your-minio-server:9000                 # Internal MinIO server endpoint
MINIO_USE_HTTPS=False                                 # Use HTTPS for internal connections
MINIO_EXTERNAL_ENDPOINT=your-minio-external-domain.com  # External MinIO endpoint for public URLs
MINIO_EXTERNAL_ENDPOINT_USE_HTTPS=True                # Use HTTPS for external endpoint
MINIO_ACCESS_KEY=your-minio-access-key                # MinIO access key for API access
MINIO_SECRET_KEY=your-minio-secret-key                # MinIO secret key for API access
MINIO_BUCKET_NAME=maipl-dev                           # Default bucket name for file storage
MINIO_PRIVATE_BUCKETS=maipl-dev                       # Comma-separated list of private buckets
MINIO_PUBLIC_BUCKETS=                                 # Comma-separated list of public buckets
MINIO_STATIC_FILES_BUCKET=static                      # Bucket for static files
MINIO_BUCKET_CHECK_ON_SAVE=True                       # Check if bucket exists when saving files
MINIO_CONSISTENCY_CHECK_ON_START=True                 # Check bucket consistency on application start
MINIO_AUTO_CREATE_MEDIA_BUCKET=False                  # Prevent automatic creation of media bucket
MINIO_AUTO_CREATE_STATIC_BUCKET=False                 # Prevent automatic creation of static bucket

# ===== Database Configuration =====
# PostgreSQL database settings
POSTGRES_DB=your-db-name                              # Database name
POSTGRES_USER=your-db-user                            # Database username
POSTGRES_PASSWORD=your-db-password                    # Database password
POSTGRES_HOST=db                                      # Database host (container name in Docker)
POSTGRES_PORT=5432                                    # Database port

# ===== Admin User Seed Configuration =====
# Initial admin user to be created when database is first set up
ADMIN_FIRST_NAME=Admin                                # Admin user first name
ADMIN_LAST_NAME=User                                  # Admin user last name
ADMIN_EMAIL=admin@example.com                         # Admin user email (used for login)
ADMIN_PASSWORD=secure-admin-password                  # Admin user password

# ===== Application Configuration =====
# General application settings
ALLOWED_REDIRECT_URLS=localhost:3000,your-frontend-domain.com  # Allowed URLs for redirects

# ===== File Cache Configuration =====
# Settings for file caching
FILE_CACHE_LOCATION=/mnt/file_cache                   # Directory for caching files

# ===== Redis Configuration =====
# Settings for Redis cache and message broker
REDIS_HOST=redis                                      # Redis host (container name in Docker)
REDIS_PORT=6379                                       # Redis port
REDIS_DB=0                                            # Redis database number
REDIS_PASSWORD=your-redis-password                    # Redis password
