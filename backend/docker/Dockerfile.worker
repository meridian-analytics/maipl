# Use an official NVIDIA CUDA runtime as a parent image
# Ubuntu 22.04 ships with Python 3.10 as the system Python (deadsnakes PPA dropped Python 3.10 for Focal)
# CUDA 11.8 is backward compatible with code targeting CUDA 11.2/11.4
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

# Set environment variables
# Set python to be unbuffered so that output is printed in real time
ENV PYTHONUNBUFFERED 1
# Set DEBIAN_FRONTEND to noninteractive to avoid tzdata prompt
ENV DEBIAN_FRONTEND=noninteractive
# Set timezone to Toronto
ENV TZ=America/Toronto

# Install Python 3.10 (system default on Ubuntu 22.04) and system packages
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    curl \
    libhdf5-serial-dev \
    libsndfile1 \
    inotify-tools \
    && rm -rf /var/lib/apt/lists/*

# Create symbolic links for Python and pip
RUN ln -sf /usr/bin/python3 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

# Set the working directory to /backend
WORKDIR /backend
COPY src/requirements.txt requirements.txt

RUN pip install --upgrade pip
RUN pip install -r requirements.txt

# Install Scipy>=1.6.0 and aural-features
RUN pip install scipy>=1.6.0
RUN pip install aural-features

RUN mkdir -p /cache
RUN mkdir -p /temp
RUN mkdir -p /logs
RUN mkdir -p /tasks

COPY src/. .
